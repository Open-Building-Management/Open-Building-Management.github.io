!- Windows Line endings 

Schedule:Constant,
    Always On,                !- Name
    Fractional,               !- Schedule Type Limits Name
    1;                        !- Hourly Value

Material,
    Generic Wall Air Gap,     !- Name
    Smooth,                   !- Roughness
    0.1,                      !- Thickness
    0.667,                    !- Conductivity
    1.28,                     !- Density
    1000,                     !- Specific Heat
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

